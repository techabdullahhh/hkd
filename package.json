{
  "name": "hashmi-ka-dera-pos",
  "productName": "Hashmi Ka Dera POS",
  "version": "1.0.0",
  "description": "Hashmi Ka Dera (HKD) \u2014 Restaurant POS & Management System",
  "author": "Hashmi Ka Dera",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run rebuild --silent",
    "dev": "electron-vite dev",
    "prestart": "npm run rebuild --silent",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pretest": "npm run rebuild:node --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "presmoke": "npm run rebuild --silent && electron-vite build",
    "smoke": "node scripts/drive.mjs",
    "prelayout-check": "npm run rebuild --silent && electron-vite build",
    "layout-check": "node scripts/layout-check.mjs",
    "db:seed": "electron-vite build && electron ./out/main/seed-cli.js",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:dir": "npm run build && electron-builder --dir",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "electron-updater": "^6.3.9",
    "nanoid": "^3.3.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zustand": "^5.0.2"
  }
}
